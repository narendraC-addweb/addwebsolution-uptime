############################################
# Build Application (Node.js)
############################################
FROM node:20-bullseye AS build
WORKDIR /app

ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=1

# Install system deps
RUN apt-get update && apt-get install -y \
    dumb-init \
    curl \
    ca-certificates \
    fonts-liberation \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdrm2 \
    libgbm1 \
    libnspr4 \
    libnss3 \
    libxkbcommon0 \
    libxcomposite1 \
    libxrandr2 \
    libxdamage1 \
    libxfixes3 \
    libasound2 \
    libxshmfence1 \
    && rm -rf /var/lib/apt/lists/*

# Create user
RUN useradd -m nodeuser

# 🔑 CRITICAL LINE (THIS WAS MISSING)
RUN chown -R nodeuser:nodeuser /app

# Now switch user
USER nodeuser

COPY --chown=nodeuser:nodeuser package.json package-lock.json ./
RUN npm ci --omit=dev --legacy-peer-deps

COPY --chown=nodeuser:nodeuser . .

RUN mkdir -p data

############################################
# ⭐ AddWebSolution Runtime Image
############################################
FROM node:20-bullseye AS uptimeaddwebmonitoring
WORKDIR /app

LABEL org.opencontainers.image.vendor="AddWeb Solution"
LABEL org.opencontainers.image.title="Uptime Kuma - AddWeb Solution"

ENV UPTIME_KUMA_IS_CONTAINER=1
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=1

RUN apt-get update && apt-get install -y \
    dumb-init \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m nodeuser
USER nodeuser

COPY --chown=nodeuser:nodeuser --from=build /app /app

EXPOSE 3001

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["node", "server/server.js"]

